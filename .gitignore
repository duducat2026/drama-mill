# Drama Mill 根忽略规则

# 依赖与构建产物
node_modules/
dist/
backend/dist
frontend/.nuxt/
frontend/.output/

# 环境与凭据：示例文件公开，真实配置一律不入库
.env
.env.*
!.env.example
.dbpass.tmp
.rescue-historical.sh
configs/config.yaml
*.pem
*.key
*.p12
*.pfx

# 备份与历史归档（不论存放位置）
backups/
*.bundle
*.sql.gz
*.dump
*.bak
*.bak.*
*.backup
*.backup.*
data/*.bak*
data/public.sql

# 运行时数据与素材（本机/部署数据）
data/static/
data/storage/
data/drama_generator.db*
data/drama_mill.db*
drama/
logs/
*.log
tmp/
temp/

# Agent 工作区：skills 定义保持跟踪，其余产出忽略
backend/workspace/*
!backend/workspace/skills/

# IDE / 工具 / OS 杂项
.idea/
.vscode/
.qoder/
.superpowers/
.claude/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# 代理说明文档（本地用，不发布）
/CLAUDE.md
/AGENTS.md

# 品牌清洗审计临时目录（勿入库/勿部署）
.cleanroom-tmp/
.dbpass.tmp
