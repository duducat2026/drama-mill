PORT=5679

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=dramamill
MYSQL_PASSWORD=dramamill_tool
MYSQL_DATABASE=drama_mill
MYSQL_CONNECTION_LIMIT=10

# ─── 模型目录价(model_list 库,平台侧只读展示模型清单与价格列表) ───
# 默认复用上面 MYSQL_* 的实例与账号(dramamill),仅切换库名为 model_list。
# 如目录库与业务库不同实例/账号,单独覆盖以下变量:
# MODEL_LIST_HOST=127.0.0.1
# MODEL_LIST_PORT=3306
# MODEL_LIST_USER=dramamill
# MODEL_LIST_PASSWORD=dramamill_tool
# MODEL_LIST_DATABASE=model_list

# Optional. Defaults to ../data/static from compiled source location.
# STORAGE_PATH=../data/static

# Optional. Public base URL of this backend. Required when passing locally
# uploaded reference videos/audios to the Seedance API (local /static paths
# are resolved as PUBLIC_BASE_URL + path).
# PUBLIC_BASE_URL=https://your-domain.com

# Optional. 关闭文本模型思考(thinking)模式,默认 true。
# 对 new-api 类中转站在请求体注入关思考参数,规避中转站强制回传
# reasoning_content 导致的 400;官方 OpenAI/Gemini 端点自动跳过。
# AI_DISABLE_THINKING=false
# 可选:自定义注入的 OpenAI 风格参数(JSON),适配不同中转站
# AI_THINKING_OFF_PATCH={"thinking":{"type":"disabled"},"enable_thinking":false}

# ─── 生产流水线并发/速率配置(按环节调节,适配上游 TPM/QPM 限额,改后重启生效) ───
# 文本类 AI 同时发起的调用上限(剧本改写/资产提取/分镜/提示词/小说分集共用,默认 3;TPM 紧张可调 1)
# TEXT_AI_MAX_CONCURRENT=3
# 相邻两次文本 AI 调用发起的最小间隔(毫秒),0=不加节奏闸门
# TEXT_AI_MIN_INTERVAL_MS=0
# 图片/视频生成各自并发槽位上限(默认各 3;未单独配置时回退 GEN_MAX_CONCURRENT)
# GEN_MAX_CONCURRENT=3
# GEN_MAX_CONCURRENT_IMAGE=3
# GEN_MAX_CONCURRENT_VIDEO=3
# 图片/视频提交节奏闸门初始间隔(毫秒,命中 429 自动翻倍/连续成功逐步减半)
# GEN_SUBMIT_INTERVAL_MS=2000
# 批量生产同时进行的短剧数(默认 1,严格按上传顺序逐部推进,最省配额)
# BATCH_DRAMA_CONCURRENCY=1
# 批量生产中单部失败是否中止整个批次(默认 false:继续下一部)
# BATCH_STOP_ON_ERROR=false
# 项目生产时单部短剧内同时并行推进的集数(默认 3;各环节仍受文本/图片/视频并发槽位与节奏闸门约束)
# PROD_EPISODE_CONCURRENCY=3
# ─── 生成任务超时与失败自动恢复(看门狗默认 5 分钟巡检一轮) ───
# 置 true 时启动阶段跳过全部任务恢复(中断任务/批次续跑/资产巡检/失败重提看门狗),
# 用于云端冻结期:重启服务不自动续跑历史任务、不消耗额度。默认(留空/注释)=不跳过
# DISABLE_TASK_RESUME=true
# 视频生成超时阈值(毫秒):超过该时长未完成的任务判失败,默认 30 分钟,下限 5 分钟
# VIDEO_TASK_TIMEOUT_MS=1800000
# 失败自动恢复巡检间隔(毫秒),默认 5 分钟,下限 1 分钟
# GEN_TASK_RECOVERY_INTERVAL_MS=300000
# 单个失败任务自动重提上限(手动重试重置计数),设为 0 关闭自动恢复,默认 3
# GEN_TASK_AUTO_RETRY_MAX=3
# 自动重提仅覆盖最近窗口期内的失败任务(毫秒),默认 6 小时,更早的留给人工处理
# GEN_TASK_AUTO_RETRY_WINDOW_MS=21600000
# 失败后至少停留该时长才自动重提(毫秒),留出手动重试缓冲,默认 2 分钟,下限 30 秒
# GEN_TASK_AUTO_RETRY_MIN_AGE_MS=120000
# 单轮巡检自动重提上限(重提走生成队列受闸门约束,仍限量防 burst),默认 20
# GEN_TASK_AUTO_RETRY_MAX_PER_SWEEP=20
