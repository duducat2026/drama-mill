# Drama Mill 后端环境变量示例
# 复制为 backend/.env 后按需修改；全部可选项留注释，取消注释即生效，改后重启服务。

# ═══ 必选：服务与数据库 ═══
PORT=5679

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=dramamill
MYSQL_PASSWORD=dramamill_tool
MYSQL_DATABASE=drama_mill
MYSQL_CONNECTION_LIMIT=10

# ═══ 模型目录价（已收编主库，无需额外配置）═══
# 模型清单与价格列表读取主库 model_catalog_models / model_catalog_prices 两张表。
# 部署后执行一次迁移脚本导入目录数据：cd backend && npx tsx scripts/migrate-model-catalog.ts
# （脚本默认读 model_list 库，可用 --source-database=<库名> 覆盖；运行时业务不再访问外部目录库）

# ═══ 存储与访问地址（可选）═══
# 素材根目录，默认 ../data/static（相对编译产物位置解析）
# STORAGE_PATH=../data/static
# 本服务对外可访问的基础 URL。本地上传统考素材给 Seedance 时必须配置
# （/static 本地路径会被换算成 PUBLIC_BASE_URL 拼接的公网地址）
# PUBLIC_BASE_URL=https://your-domain.com

# ═══ 文本模型思考模式（可选）═══
# 默认注入"关闭 thinking"参数以兼容 new-api 类中转站（其强制回传
# reasoning_content 会致 400）；官方 OpenAI/Gemini 端点自动跳过。
# AI_DISABLE_THINKING=false
# 自定义 OpenAI 风格注入参数（JSON）：
# AI_THINKING_OFF_PATCH={"thinking":{"type":"disabled"},"enable_thinking":false}

# ═══ 流水线并发与节奏闸门（按上游限额调节，改后重启生效）═══
# 文本 AI 同时调用上限（剧本/提取/分镜/提示词/分集共用；默认 3，TPM 紧张降到 1）
# TEXT_AI_MAX_CONCURRENT=3
# 相邻文本调用最小间隔毫秒（0 = 不限速）
# TEXT_AI_MIN_INTERVAL_MS=0
# 图片/视频生成并发槽位（未单独配置时回退 GEN_MAX_CONCURRENT）
# GEN_MAX_CONCURRENT=3
# GEN_MAX_CONCURRENT_IMAGE=3
# GEN_MAX_CONCURRENT_VIDEO=3
# 生成提交节奏初始间隔毫秒（命中 429 翻倍、连续成功减半自适应）
# GEN_SUBMIT_INTERVAL_MS=2000
# 批量生产并行短剧数（默认 1，按上传顺序逐部推进最省配额）
# BATCH_DRAMA_CONCURRENCY=1
# 批次内单部失败是否中止整批（默认 false：继续下一部）
# BATCH_STOP_ON_ERROR=false
# 单部剧并行推进的集数（默认 3；仍受各环节槽位与闸门约束）
# PROD_EPISODE_CONCURRENCY=3

# ═══ 任务超时与看门狗自动恢复（默认 5 分钟巡检一轮）═══
# 启动阶段跳过全部任务恢复（中断续跑/批次续跑/资产巡检/失败重提）。
# 云端冻结期置 true：重启不自动续跑历史任务、不消耗额度
# DISABLE_TASK_RESUME=true
# 视频任务墙钟超时毫秒（默认 30 分钟，下限 5 分钟，超时判失败）
# VIDEO_TASK_TIMEOUT_MS=1800000
# 失败恢复巡检间隔毫秒（默认 5 分钟，下限 1 分钟）
# GEN_TASK_RECOVERY_INTERVAL_MS=300000
# 单任务自动重提次数上限（手动重试会重置计数；0 = 关闭自动恢复）
# GEN_TASK_AUTO_RETRY_MAX=3
# 自动重提只覆盖该窗口内的失败（毫秒，默认 6 小时，更早留给人工）
# GEN_TASK_AUTO_RETRY_WINDOW_MS=21600000
# 失败后至少等待该时长才自动重提（毫秒，留手动重试缓冲；默认 2 分钟，下限 30 秒）
# GEN_TASK_AUTO_RETRY_MIN_AGE_MS=120000
# 单轮巡检自动重提数量上限（防突发；重提仍受生成队列闸门约束）
# GEN_TASK_AUTO_RETRY_MAX_PER_SWEEP=20
