// tsconfig 为 TS 官方模板选项集，语义不可变；此处仅按本项目场景标注各选项意图。
{
  "compilerOptions": {
    "declaration": true,
    "esModuleInterop": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["node"],
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/**/*"]
}
