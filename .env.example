# Drama Mill 环境变量示例（复制为 .env 后按需修改）

# ── 服务 ──
PORT=5679
NODE_ENV=production

# ── 数据库（DATABASE_URL 优先，否则用分项配置） ──
# ⚠️ 口令占位 CHANGE_ME 必须换成你自己的强口令：应用与 compose 均不再提供默认口令，
#    未配置或仍为 CHANGE_ME 时数据库不可用（compose 则直接报错退出）。
#    可用 `openssl rand -base64 24` 生成，并确保 URL 中的特殊字符已做百分号编码。
DATABASE_URL=mysql://dramamill:CHANGE_ME@127.0.0.1:3306/drama_mill
# MYSQL_ROOT_PASSWORD=CHANGE_ME
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=dramamill
# MYSQL_PASSWORD=CHANGE_ME
# MYSQL_DATABASE=drama_mill

# ── 认证 ──
# 必填，生成方式: openssl rand -base64 32
JWT_SECRET=
JWT_TTL=7d

# ── 生成调度 ──
# 并发执行任务上限
GEN_MAX_CONCURRENT=3
# 无 QPM 配置时的默认提交间隔（毫秒）
GEN_SUBMIT_INTERVAL_MS=2000

# ── 存储目录隔离 ──
# 存储根目录（未分类文件与分类目录的默认父目录）
STORAGE_PATH=./data/static
# 分类根目录（可指向项目目录之外的独立磁盘/目录，素材不进构建上下文）：
# 图片素材库（资产形象图/生成图）
ASSET_PATH=./data/static/images
# 视频片段（镜头生成产物）
VIDEO_PATH=./data/static/videos
# 拼接成片
MERGED_PATH=./data/static/merged
# 上传素材/原文留档
UPLOAD_PATH=./data/static/uploads
